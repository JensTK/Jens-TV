<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>JensTV</RootNamespace>
    <AssemblyName>JensTV</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>jenstv.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The tray listener is its own project (below); keep its sources out of this one. -->
    <Compile Remove="Listener\**" />
    <None Remove="Listener\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built alongside: JensTV.Listener.exe lands next to JensTV.exe (its OutDir), not referenced as a library. -->
    <ProjectReference Include="Listener\JensTV.Listener.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

</Project>
